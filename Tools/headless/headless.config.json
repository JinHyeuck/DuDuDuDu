{
  // Unity 에디터를 열지 않고 EditMode 테스트를 돌리는 헤드리스 러너 설정.
  //
  // 경로는 전부 리포 루트(이 파일에서 두 단계 위) 기준 상대 경로다.
  // 리팩토링으로 어셈블리가 늘어나면 여기 assemblies 에 항목만 추가하면 된다.

  // Unity 프로젝트 폴더.
  "projectPath": "DuDuDuDU_Project",

  // "auto" 면 ProjectSettings/ProjectVersion.txt 의 m_EditorVersion 을 따른다.
  // 에디터를 올려도 이 파일은 손댈 것이 없다.
  "unityVersion": "auto",

  // Unity Hub 설치 루트 후보. 환경변수 UNITY_EDITOR_ROOT 가 있으면 그게 우선이다.
  "unityHubRoots": [
    "C:/Program Files/Unity/Hub/Editor",
    "%LOCALAPPDATA%/Unity/Hub/Editor",
    "D:/Program Files/Unity/Hub/Editor"
  ],

  // Unity 6000.3 의 스크립트 컴파일 언어 버전.
  "langVersion": "9.0",

  // 테스트 프로세스에 넘길 환경변수. 값이 상대 경로면 리포 루트 기준으로 절대화한다.
  //
  // OJ_GOLDEN_BASELINE 은 Assets/Tests/EditMode/GoldenBaseline.cs 가 읽는다.
  // 에디터 안에서는 Application.dataPath 로 기준선 파일을 찾지만 에디터 밖에서는
  // 그 API 를 쓸 수 없어 경로를 직접 넘겨 준다. Unity 안에서는 이 변수가 설정되지
  // 않으므로 에디터에서의 동작은 그대로다.
  "environment": {
    "OJ_GOLDEN_BASELINE": "DuDuDuDU_Project/Tests/Golden/formula_baseline.txt"
  },

  // 빌드할 어셈블리. 위에서부터 순서대로 컴파일되고, references 에는 앞서 빌드된
  // 어셈블리 이름을 쓸 수 있다. Unity 의 asmdef 와 이름/소스 경로를 맞춰 뒀다.
  "assemblies": [
    {
      "name": "OJ.Core",
      "sources": [ "DuDuDuDU_Project/Assets/Scripts/Core" ],

      // 11.1 에서 noEngineReferences: true 로 바꿨다. 러너는 UnityEngine 참조를 항상
      // 넣으므로 여기 표시만으로는 그 제약이 검증되지 않는다 — Unity 쪽 컴파일이
      // 진짜 관문이다. 이 주석은 그 사실을 잊지 않기 위한 것이다.

      // "package:<파일명>" 은 패키지에 그대로 들어 있는 미리 컴파일된 DLL 을 뜻한다.
      // scriptAssemblies 와 달리 에디터가 만들어 내는 산출물이 아니라 낡을 일이 없다.
      // Unity 쪽 대응은 OJ.Core.asmdef 의 overrideReferences + precompiledReferences 다.
      "references": [ "package:Newtonsoft.Json.dll" ]
    },
    {
      "name": "OJ.Core.Tests",
      "sources": [ "DuDuDuDU_Project/Assets/Tests/EditMode" ],
      "references": [ "OJ.Core", "nunit", "package:Newtonsoft.Json.dll" ],

      // Unity 가 Editor 전용 어셈블리에만 넣어 주는 심볼.
      "defines": [ "UNITY_EDITOR_ONLY_COMPILATION" ],
      "test": true,

      // 수집돼야 하는 최소 테스트 개수. 이보다 적게 수집되면 러너가 실패로 떨어뜨린다.
      // 0건만 막아서는 부족하다 — 테스트 파일 하나가 통째로 사라져도 남은 것이 전부
      // 통과라 초록불이 나온다. 실제로 검증 중에 그 시나리오를 재현해 확인했다.
      //
      // 갱신 이력: 496 (3.3 기준선) -> 1282 (5.1-a2 받는쪽 잠금)
      //            -> 1612 (core.dmgChain 픽스처) -> 1935 (5.1-b 크리 잠금)
      //            -> 3232 (5.2 장비 규칙·보석 보너스 잠금)
      //            -> 3273 (7.2~7.4 저장 파이프라인)
      // 테스트를 의도적으로 줄였다면 같은 커밋에서 이 숫자도 낮출 것.
      "minTests": 3273
    },
    {
      // 게임 코드 본체. 테스트 어셈블리가 아니라 "컴파일이 되는지"만 본다.
      //
      // 왜 필요한가: 이게 없으면 러너가 Assembly-CSharp 의 컴파일 오류를 통째로 못 본다.
      // 실제로 using 누락(UnityEngine.SceneManagement)이 러너를 통과했고, 5.2 에서
      // EquipmentManager 의 위임 코드에 변이를 심어도 러너는 0건을 잡았다. 이 어셈블리를
      // 컴파일 대상에 넣는 것이 그 사각지대를 없애는 최소한의 조치다.
      //
      // 참고: 여기 담기는 코드에 대한 "동작" 검증은 아니다. 컴파일만 통과시킨다.
      "name": "OJ.Game",
      "sources": [ "DuDuDuDU_Project/Assets/Scripts" ],

      // Unity 가 이 어셈블리에 넣지 않는 것들을 똑같이 뺀다. 섞으면 컴파일이 깨진다.
      //   Core/*      → OJ.Core asmdef 소속. 위에서 이미 따로 컴파일하고 참조로 잇는다.
      //   Editor/*    → Assets/Scripts/Editor. Assembly-CSharp-Editor 소속이다.
      //   */Editor/*  → Build/Editor, Relic/Editor 등 하위의 Editor 폴더 전부.
      // 패턴은 파일 이름과 sources 기준 상대 경로 둘 다에 대 본다.
      "exclude": [ "Core/*", "Editor/*", "*/Editor/*" ],

      // unityEditor      → 런타임 코드의 #if UNITY_EDITOR 블록 때문에 필요하다
      //                    (defines 에 UNITY_EDITOR 가 들어 있다). 예: SpritePointLightController.
      // scriptAssemblies → UniTask/TextMeshPro/uGUI 처럼 Unity 밖에서 만들 수 없는 패키지 DLL.
      //                    Assets/Plugins 는 별도 asmdef 라 소스로 넣지 않고 여기로 잇는다.
      "references": [ "OJ.Core", "unityEditor", "scriptAssemblies" ],

      // Assembly-CSharp 의 에디터 절반. 이 러너는 Editor 코드를 컴파일하지 않으므로
      // ScriptAssemblies 에 남아 있는 것은 낡은 DLL 이다. 참조에 끼면 확장 메서드 탐색이
      // 그 안을 들여다보다 엉뚱한 오류를 낸다.
      "excludeReferences": [ "OJ.Game.Editor", "Assembly-CSharp", "Assembly-CSharp-Editor" ],

      // Utils/Extensions.cs 에 unsafe 블록이 2곳 있다. 끄면 CS0227 로 죽는다.
      // Unity 쪽 대응은 Player Settings 의 "Allow 'unsafe' Code".
      "unsafe": true,

      "test": false
    },
    {
      // 에디터 도구. 여기 없으면 에디터 스크립트의 컴파일 오류를 러너가 통째로 못 본다 —
      // 그리고 에디터 도구는 "Unity 를 열어서 메뉴를 눌러야" 처음 드러나므로, 오류가 있으면
      // 사람 손을 한 번 낭비시킨 뒤에야 알게 된다. 리팩토링 중 도구가 6개까지 늘어나
      // 그 왕복 비용이 무시할 수 없어졌다.
      //
      // 소스는 Assets/Scripts 아래 흩어진 Editor/ 폴더 전부다. 폴더를 나열하지 않고
      // include 패턴으로 둔 것은, 새 Editor 폴더가 생겼을 때 조용히 빠지지 않게 하기 위함이다.
      "name": "OJ.Game.Editor",
      "sources": [ "DuDuDuDU_Project/Assets/Scripts/Editor" ],

      // Core/Editor 가 생기면 그건 OJ.Core.Editor 소속이지 여기가 아니다. 아직 없지만
      // 11단계에서 asmdef 를 쪼갤 때 실수하기 쉬운 자리라 미리 막아 둔다.
      "exclude": [ "Core/*" ],

      // Unity 가 Assembly-CSharp-Editor 에 넣는 참조와 같다. Assembly-CSharp 을 보고,
      // ScriptAssemblies 에서 낡은 자기 자신은 빼야 한다.
      "references": [ "OJ.Core", "OJ.Game", "unityEditor", "scriptAssemblies" ],
      "excludeReferences": [ "OJ.Game.Editor", "Assembly-CSharp", "Assembly-CSharp-Editor" ],

      "unsafe": true,
      "test": false
    }
  ],

  // Unity 6000.3.7f1 이 스크립트 어셈블리에 넣는 define 목록 그대로다.
  // (Unity 가 만든 DuDuDuDU_Project/OJ.Core.csproj 의 DefineConstants 에서 뽑았다.)
  // 에디터를 올려서 목록이 바뀌면 여기도 다시 뽑아 넣으면 된다.
