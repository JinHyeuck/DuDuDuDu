<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unity 에디터 없이 EditMode 테스트를 돌리는 러너.
    이 프로젝트는 NuGet 패키지를 하나도 참조하지 않는다 — 오프라인에서도 복원/빌드가 된다.
    Roslyn 컴파일러와 nunit.framework.dll 은 Unity 설치본/PackageCache 에서 런타임에 찾아 쓴다.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OJ.Headless.Runner</AssemblyName>
    <RootNamespace>OJ.Headless</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

</Project>
