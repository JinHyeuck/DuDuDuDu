    requiredWave: 0
    requiredWaveStage: 1
    requiresRunEnded: 0
    presentation: 0
    displayName: "\uD2B9\uBCC4\uD55C 7\uC77C"
    description: "7\uC77C \uB3D9\uC548 \uB9E4\uC77C \uBCF4\uC11D\uC744 \uBC1B\uC544\uC694."
    guideTapText: 
    guideDetailText: 
  - contentId: 6
    requiredClear: 4
    requiredWave: 0
    requiredWaveStage: 1
    requiresRunEnded: 0
    presentation: 2
    displayName: "\uC18C\uD0D5"
    description: "\uAE6C \uC2A4\uD14C\uC774\uC9C0\uC758 \uBCF4\uC0C1\uC744 \uBC14\uB85C
      \uBC1B\uC544\uC694."
    guideTapText: "\uC18C\uD0D5\uC774 \uC5F4\uB838\uC5B4\uC694! \uB20C\uB7EC \uBCF4\uC138\uC694."
    guideDetailText: "\uACE0\uAE30\uB97C \uC368\uC11C \uAE6C \uC2A4\uD14C\uC774\uC9C0
      \uBCF4\uC0C1\uC744\n\uC804\uD22C \uC5C6\uC774 \uBC1B\uC544\uC694."
  - contentId: 12
    requiredClear: 5
    requiredWave: 0
    requiredWaveStage: 1
    requiresRunEnded: 0
    presentation: 0
    displayName: "\uC2DC\uC98C \uD328\uC2A4"
    description: "\uACE0\uAE30\uB97C \uC4F0\uBA74 \uD328\uC2A4\uAC00 \uC62C\uB77C\n\uBCF4\uC0C1\uC744
      \uBC1B\uC544\uC694."
    guideTapText: 
    guideDetailText: 
  - contentId: 10
    requiredClear: 5
    requiredWave: 0
    requiredWaveStage: 1
    requiresRunEnded: 0
    presentation: 2
    displayName: "\uC0C1\uC810"
    description: "\uBCF4\uC11D\uC744 \uBF51\uC544 \uC7A5\uBE44\uC5D0 \uB07C\uC6CC\uC694."
    guideTapText: "\uC0C1\uC810\uC774 \uC5F4\uB838\uC5B4\uC694! \uB20C\uB7EC \uBCF4\uC138\uC694."
    guideDetailText: "\uBCF4\uC11D\uC744 \uBF51\uC544\uC11C \uC7A5\uBE44 \uCE78\uC5D0
      \uB07C\uC6B0\uBA74\n\uB2A5\uB825\uCE58\uAC00 \uC62C\uB77C\uC694."
  - contentId: 13
    requiredClear: 6
    requiredWave: 0
    requiredWaveStage: 1
    requiresRunEnded: 0
    presentation: 2
    displayName: "\uC720\uBB3C"
    description: "\uC720\uBB3C\uC744 \uC18C\uD658\uD574\n\uC804\uD22C\uB97C \uC720\uB9AC\uD558\uAC8C
      \uB9CC\uB4E4\uC5B4\uC694."
    guideTapText: "\uC720\uBB3C\uC774 \uC5F4\uB838\uC5B4\uC694! \uB20C\uB7EC \uBCF4\uC138\uC694."
    guideDetailText: "\uC720\uBB3C\uC740 \uC804\uD22C \uB0B4\uB0B4 \uD6A8\uACFC\uB97C
      \uC918\uC694.\n\uC18C\uD658\uD558\uACE0 \uB808\uBCA8\uC744 \uC62C\uB824 \uBD10\uC694."
