    presentation: 0
    displayName: "\uBCC4\uC758 \uCD95\uC81C"
    description: "\uBCC4\uC744 \uBAA8\uC73C\uBA74 \uBCF4\uC0C1\uC744 \uBC1B\uC544\uC694."
    guideTapText: 
    guideDetailText: 
  - contentId: 0
    requiredClear: 0
    requiredWave: 0
    requiredWaveStage: 1
    requiresRunEnded: 0
    presentation: 2
    displayName: "\uB2E4\uC774\uC2A4"
    description: "\uB2E4\uC774\uC2A4\uB97C \uAC15\uD654\uD558\uBA74\n\uC804\uD22C\uC5D0\uC11C
      \uB354 \uAC15\uD574\uC838\uC694."
    guideTapText: "\uB2E4\uC774\uC2A4\uAC00 \uC5F4\uB838\uC5B4\uC694!\n\uAC15\uD654\uD574 \uBD10\uC694."
    guideDetailText: "\uC5EC\uAE30\uC11C \uB2E4\uC774\uC2A4\uB97C \uAC15\uD654\uD558\uACE0\n\uC0C8
      \uB2E4\uC774\uC2A4\uB97C \uC5F4 \uC218 \uC788\uC5B4\uC694."
  - contentId: 2
    requiredClear: 1
    requiredWave: 0
    requiredWaveStage: 1
    requiresRunEnded: 1
    presentation: 2
    displayName: "\uD074\uB9AC\uC5B4 \uBCF4\uC0C1"
    description: "\uC6E8\uC774\uBE0C\uB97C \uAE70\uC218\uB85D\n\uBCF4\uC0C1\uC744
      \uBC1B\uC544\uC694."
    guideTapText: "\uC6E8\uC774\uBE0C\uB97C \uAE68\uBA74 \uBCF4\uC0C1\uC744 \uBC1B\uC544\uC694!\n\uB20C\uB7EC\uC11C
      \uD655\uC778\uD574 \uBD10\uC694."
    guideDetailText: "\uC6E8\uC774\uBE0C\uB97C \uB9CE\uC774 \uAE70\uC218\uB85D\n\uB354
      \uC88B\uC740 \uBCF4\uC0C1\uC774 \uC5F4\uB824\uC694."
  - contentId: 3
    requiredClear: 1
    requiredWave: 0
    requiredWaveStage: 1
    requiresRunEnded: 0
    presentation: 1
    displayName: "\uBC29\uCE58 \uBCF4\uC0C1"
    description: "\uAC8C\uC784\uC744 \uAEBC \uB46C\uB3C4 \uBCF4\uC0C1\uC774 \uC313\uC5EC\uC694.\n\uC790\uC8FC
      \uBC1B\uC73C\uB7EC \uC640\uC694!"
    guideTapText: 
    guideDetailText: 
  - contentId: 5
    requiredClear: 1
    requiredWave: 0
    requiredWaveStage: 1
    requiresRunEnded: 0
    presentation: 2
    displayName: "\uACE0\uAE30 \uCD95\uC81C"
    description: "\uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uACE0\uAE30\uAC00 \uAD6C\uC6CC\uC838\uC694.\n\uB20C\uB7EC\uC11C
      \uBC1B\uC544\uC694!"
    guideTapText: "\uACE0\uAE30\uAC00 \uAD6C\uC6CC\uC84C\uC5B4\uC694! \uB20C\uB7EC
      \uBCF4\uC138\uC694."
    guideDetailText: "\uACE0\uAE30\uB294 \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74 \uC313\uC5EC\uC694.\n\uAC00\uB4DD
      \uCC28\uAE30 \uC804\uC5D0 \uBC1B\uC544 \uAC00\uC694."
  - contentId: 1
    requiredClear: 2
    requiredWave: 10
    requiredWaveStage: 2
    requiresRunEnded: 0
    presentation: 2
    displayName: "\uC7A5\uBE44"
    description: "\uC7A5\uBE44\uB97C \uAC15\uD654\uD558\uBA74 \uB2E4\uC774\uC2A4\uAC00
      \uB354 \uC138\uC838\uC694."
    guideTapText: "2\uC2A4\uD14C\uC774\uC9C0 10\uC6E8\uC774\uBE0C\uB97C \uB118\uC5C8\uC5B4\uC694!\n\uC7A5\uBE44\uAC00
       \uC5F4\uB838\uC5B4\uC694. \uB20C\uB7EC \uBCF4\uC138\uC694."
    guideDetailText: "\uACE8\uB4DC\uB85C \uC7A5\uBE44\uB97C \uAC15\uD654\uD558\uBA74\n\uBAA8\uB4E0
      \uB2E4\uC774\uC2A4\uC758 \uACF5\uACA9\uB825\uC774 \uC62C\uB77C\uC694."
  - contentId: 9
    requiredClear: 2
    requiredWave: 0
    requiredWaveStage: 1
    requiresRunEnded: 0
    presentation: 2
    displayName: "\uD540\uBCFC"
    description: "\uD2F0\uCF13\uC73C\uB85C \uD540\uBCFC\uC744 \uAD74\uB824\n\uACE0\uAE30\uC640
      \uBCF4\uC0C1\uC744 \uBC1B\uC544\uC694."
    guideTapText: "\uD540\uBCFC\uC774 \uC5F4\uB838\uC5B4\uC694! \uB20C\uB7EC \uBCF4\uC138\uC694."
    guideDetailText: "\uD2F0\uCF13\uC73C\uB85C \uACF5\uC744 \uC3D8\uBA74\n\uB9DE\uD78C
      \uD540\uB9CC\uD07C \uBCF4\uC0C1\uC744 \uBC1B\uC544\uC694."
  - contentId: 8
    requiredClear: 3
    requiredWave: 0
    requiredWaveStage: 1
    requiresRunEnded: 0
    presentation: 1
    displayName: "\uD018\uC2A4\uD2B8"
    description: "\uBBF8\uC158\uC744 \uAE68\uACE0 \uBCF4\uC0C1\uC744 \uBC1B\uC544\uC694."
    guideTapText: 
    guideDetailText: 
  - contentId: 14
    requiredClear: 3
    requiredWave: 0
    requiredWaveStage: 1
    requiresRunEnded: 0
    presentation: 2
    displayName: "\uBB34\uD55C\uC758 \uD0D1"
    description: "\uCE35\uC744 \uC62C\uB77C \uD0B9 \uB2E4\uC774\uC2A4\uB97C \uC5BB\uC5B4\uC694.\n\uBD09\uC778\uB41C
      \uC544\uB7AB\uC904\uB3C4 \uD0D1\uC5D0\uC11C \uD480\uC5B4\uC694."
    guideTapText: "\uBB34\uD55C\uC758 \uD0D1\uC774 \uC5F4\uB838\uC5B4\uC694! \uB20C\uB7EC
      \uBCF4\uC138\uC694."
    guideDetailText: "1\uCE35\uC744 \uAE68\uBA74 \uBD09\uC778\uC774 \uD480\uB824\uC694.\n\uCE35\uC744
      \uAE70\uC218\uB85D \uBCF4\uC0C1\uC774 \uCEE4\uC9C0\uACE0,\n\uC815\uD574\uC9C4
      \uCE35\uC5D0\uC11C \uD0B9 \uB2E4\uC774\uC2A4\uAC00 \uC5F4\uB824\uC694."
  - contentId: 11
    requiredClear: 4
    requiredWave: 0
    requiredWaveStage: 1
    requiresRunEnded: 0
    presentation: 0
    displayName: "\uBA64\uBC84\uC2ED"
    description: "\uBA64\uBC84\uC2ED \uD61C\uD0DD\uC744 \uBC1B\uC544\uC694."
    guideTapText: 
    guideDetailText: 
  - contentId: 7
